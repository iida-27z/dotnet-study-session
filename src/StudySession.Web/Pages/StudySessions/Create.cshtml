@page "/study_sessions/create"
@model StudySession.Web.Pages.StudySessions.CreateModel
@{
    ViewData["Title"] = "勉強会作成";
}

<section class="common-container">
    <nav class="breadcrumb" aria-label="パンくずリスト">
        <ol class="breadcrumb-list">
            <li><a asp-page="/StudySessions/List" class="link-reset">勉強会一覧</a></li>
            <li><span aria-current="page">新規作成</span></li>
        </ol>
    </nav>

    <h1 class="page-title">新規勉強会の登録</h1>
    <p class="page-lead">対面・リモートの開催形式と定員を設定して登録します。</p>
    <hr>

    <div asp-validation-summary="ModelOnly" class="error-message" role="alert"></div>

    <form method="post" class="content-stack" id="create-study-session-form">
        <input asp-for="StartTimeUtcValue" type="hidden" id="StartTimeUtcValue" />
        <input asp-for="EndTimeUtcValue" type="hidden" id="EndTimeUtcValue" />

        <div>
            <label asp-for="Title" class="bold">勉強会テーマ</label>
            <span class="field-required" aria-hidden="true">*必須</span>
            <input asp-for="Title" class="input-wide margin-top-05" placeholder="例: Spring Boot 3.x 移行実践ワークショップ" />
            <span asp-validation-for="Title" class="error-message"></span>
        </div>

        <div>
            <label asp-for="StartTime" class="bold">開始日時</label>
            <span class="field-required" aria-hidden="true">*必須</span>
            <input asp-for="StartTime" type="datetime-local" class="input-wide margin-top-05" />
            <span asp-validation-for="StartTime" class="error-message"></span>
        </div>

        <div>
            <label asp-for="EndTime" class="bold">終了日時</label>
            <span class="field-required" aria-hidden="true">*必須</span>
            <input asp-for="EndTime" type="datetime-local" class="input-wide margin-top-05" />
            <span asp-validation-for="EndTime" class="error-message"></span>
        </div>

        <div>
            <label asp-for="Format" class="bold">開催形式</label>
            <span class="field-required" aria-hidden="true">*必須</span>
            <div class="inline-option-group">
                <label><input asp-for="Format" type="radio" value="Hybrid" /> ハイブリッド (対面 + リモート)</label>
                <label><input asp-for="Format" type="radio" value="OnsiteOnly" /> 対面のみ</label>
                <label><input asp-for="Format" type="radio" value="RemoteOnly" /> リモートのみ</label>
            </div>
            <span asp-validation-for="Format" class="error-message"></span>
        </div>

        <div class="form-grid">
            <div>
                <label asp-for="CapacityOnsite" class="bold">対面枠 定員 (名)</label>
                <input asp-for="CapacityOnsite" class="input-wide margin-top-05" min="0" max="200" />
                <p class="helper-text">※対面非対応の場合は「0」に設定</p>
                <span asp-validation-for="CapacityOnsite" class="error-message"></span>
            </div>
            <div>
                <label asp-for="CapacityRemote" class="bold">リモート枠 定員 (名)</label>
                <input asp-for="CapacityRemote" class="input-wide margin-top-05" min="0" max="500" />
                <p class="helper-text">※リモート非対応の場合は「0」に設定</p>
                <span asp-validation-for="CapacityRemote" class="error-message"></span>
            </div>
        </div>

        <div>
            <label asp-for="Description" class="bold">概要</label>
            <textarea asp-for="Description" class="input-wide margin-top-05" rows="4"
                      placeholder="勉強会の目的、事前準備、オンラインURL等を記載してください。"></textarea>
            <span asp-validation-for="Description" class="error-message"></span>
        </div>

        <div class="button-row" style="margin-top: 1.5rem;">
            <button type="submit" class="btn-primary">登録して公開する</button>
            <a asp-page="/StudySessions/List" class="btn-secondary">キャンセル</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('create-study-session-form');
            if (!form) {
                return;
            }

            const setIsoValue = (inputId, hiddenId) => {
                const input = document.getElementById(inputId);
                const hidden = document.getElementById(hiddenId);
                if (!input || !hidden || !input.value) {
                    if (hidden) {
                        hidden.value = '';
                    }
                    return;
                }

                const localDate = new Date(input.value);
                if (Number.isNaN(localDate.getTime())) {
                    hidden.value = '';
                    return;
                }

                hidden.value = localDate.toISOString();
            };

            form.addEventListener('submit', () => {
                setIsoValue('StartTime', 'StartTimeUtcValue');
                setIsoValue('EndTime', 'EndTimeUtcValue');
            });
        })();
    </script>
}
